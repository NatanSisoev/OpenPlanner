{
  "name": "hackupc-planstack-spike",
  "displayName": "HackUPC Planstack",
  "description": "Phased plans, sidebar orchestration, separate planning (Chat) and execution (Run phase) settings.",
  "version": "0.0.1",
  "publisher": "hackupc",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:hackupc.planstack.ui",
    "onView:hackupc.planstack.chat",
    "onView:hackupc.planstackPlans",
    "onCommand:hackupc.planstack.refresh",
    "onCommand:hackupc.planstack.runPhase",
    "onCommand:hackupc.planstack.taskSetState.pending",
    "onCommand:hackupc.planstack.taskSetState.in_progress",
    "onCommand:hackupc.planstack.taskSetState.completed",
    "onCommand:hackupc.planstack.taskSetState.failed",
    "onCommand:hackupc.planstack.taskSetState.cancelled",
    "onCommand:hackupc.planstack.setCursorApiKey",
    "onCommand:hackupc.planstack.debugCliConnection",
    "onCommand:hackupc.nativeHandoff.demo"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hackupc-planstack",
          "title": "Planstack",
          "icon": "media/planstack.svg"
        }
      ]
    },
    "views": {
      "hackupc-planstack": [
        {
          "id": "hackupc.planstack.ui",
          "name": "Overview",
          "type": "webview"
        },
        {
          "id": "hackupc.planstackPlans",
          "name": "Plans"
        },
        {
          "id": "hackupc.planstack.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "hackupc.planstack.refresh",
        "title": "Planstack: Refresh plans",
        "icon": "$(refresh)"
      },
      {
        "command": "hackupc.planstack.runPhase",
        "title": "Planstack: Run phase (execution)"
      },
      {
        "command": "hackupc.planstack.taskSetState.pending",
        "title": "Pending"
      },
      {
        "command": "hackupc.planstack.taskSetState.in_progress",
        "title": "In progress"
      },
      {
        "command": "hackupc.planstack.taskSetState.completed",
        "title": "Completed"
      },
      {
        "command": "hackupc.planstack.taskSetState.failed",
        "title": "Failed"
      },
      {
        "command": "hackupc.planstack.taskSetState.cancelled",
        "title": "Cancelled"
      },
      {
        "command": "hackupc.planstack.setCursorApiKey",
        "title": "Planstack: Set Cursor API key"
      },
      {
        "command": "hackupc.planstack.debugCliConnection",
        "title": "Planstack: Debug Cursor CLI connection"
      },
      {
        "command": "hackupc.nativeHandoff.demo",
        "title": "HackUPC: Native handoff demo (clipboard + Composer)"
      }
    ],
    "submenus": [
      {
        "id": "hackupc.planstack.taskSetState",
        "label": "Set state"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hackupc.planstack.refresh",
          "when": "view == hackupc.planstackPlans",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "hackupc.planstack.runPhase",
          "when": "view == hackupc.planstackPlans && viewItem == hackupcPhase",
          "group": "inline@0"
        },
        {
          "submenu": "hackupc.planstack.taskSetState",
          "when": "view == hackupc.planstackPlans && viewItem == hackupcTask",
          "group": "inline@1"
        }
      ],
      "submenu/hackupc.planstack.taskSetState": [
        {
          "command": "hackupc.planstack.taskSetState.pending",
          "group": "0_state"
        },
        {
          "command": "hackupc.planstack.taskSetState.in_progress",
          "group": "1_state"
        },
        {
          "command": "hackupc.planstack.taskSetState.completed",
          "group": "2_state"
        },
        {
          "command": "hackupc.planstack.taskSetState.failed",
          "group": "3_state"
        },
        {
          "command": "hackupc.planstack.taskSetState.cancelled",
          "group": "4_state"
        }
      ]
    },
    "configuration": {
      "title": "Planstack",
      "properties": {
        "planstack.cursor.planningMode": {
          "type": "string",
          "default": "cli",
          "enum": ["cli"],
          "description": "How Chat → Create plan produces structured plan JSON. \"cli\" uses the Cursor headless agent in read-only print mode. Additional values may be added later."
        },
        "planstack.cursor.executionMode": {
          "type": "string",
          "default": "cli",
          "enum": ["", "native-first", "sdk-local", "sdk-cloud", "cli"],
          "markdownDescription": "How **Run phase** runs (Plans tree). Default **`cli`** runs the Cursor agent in the workspace with `--force`. Leave **empty** to use legacy `planstack.cursor.handoff`. Set **`native-first`** for clipboard + optional Composer command instead.",
          "enumDescriptions": [
            "Use legacy `planstack.cursor.handoff` when valid; otherwise cli.",
            "Clipboard + optional Composer command (paste handoff).",
            "Cursor SDK local (stub unless implemented).",
            "Cursor SDK cloud (stub unless implemented).",
            "Headless Cursor agent with --force in the workspace (may edit files); needs CURSOR_API_KEY and agent on PATH (see README)."
          ]
        },
        "planstack.cursor.handoff": {
          "type": "string",
          "default": "cli",
          "enum": ["native-first", "sdk-local", "sdk-cloud", "cli"],
          "markdownDescription": "**Deprecated:** use `planstack.cursor.executionMode` for phase execution. Still read when `executionMode` is empty, for existing workspaces."
        },
        "planstack.cursor.openComposerCommand": {
          "type": "string",
          "default": "",
          "description": "Optional VS Code command ID to open or focus Cursor Composer/Agent after the prompt is copied. Overrides legacy hackupc.nativeHandoff.openComposerCommand when set."
        },
        "hackupc.nativeHandoff.openComposerCommand": {
          "type": "string",
          "default": "",
          "description": "Legacy: same as planstack.cursor.openComposerCommand. Used when planstack.cursor.openComposerCommand is empty."
        },
        "planstack.cursor.agentPath": {
          "type": "string",
          "default": "agent",
          "description": "Executable for the Cursor headless CLI (must be on PATH or an absolute path). Used for Chat → Create plan (planning) and CLI-based execution when wired."
        },
        "planstack.cursor.agentTimeoutMs": {
          "type": "number",
          "default": 180000,
          "minimum": 10000,
          "description": "Max wait for a single agent -p run (milliseconds). Applies to planning (Create plan) and CLI execution paths."
        },
        "planstack.cursor.agentMaxStdoutChars": {
          "type": "number",
          "default": 2000000,
          "minimum": 10000,
          "description": "Max stdout characters captured from agent (safety cap). Applies to planning and CLI execution paths."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  }
}
